# Copy to .env (or run: npm run make-env) and fill in. Never commit .env.
# Random secrets, base64 (make-env generates them). TOKEN_KEY must be 32 bytes.
SESSION_SECRET=
TOKEN_KEY=
# The address people open, e.g. https://bills.example.vn (http://localhost:8080 locally)
PUBLIC_URL=http://localhost:8080
# Where the SQLite file and nightly backups live (/data in Docker)
DATA_DIR=./data
PORT=8080
# Google "Web application" OAuth client for the company Drive (docs/server-setup.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
